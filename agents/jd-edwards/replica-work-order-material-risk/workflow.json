              "inputTypes": [
                "message"
              ],
              "required": true,
              "value": "SELECT w.WORK_ORDER_TYPE,w.WORK_ORDER_NUMBER,w.WORK_ORDER_SUFFIX,w.BRANCH_PLANT,w.WORK_ORDER_DESCRIPTION,w.UOM,w.PLANNED_START_DATE,w.REQUESTED_COMPLETION_DATE FROM PAF_JDE_API.WORK_ORDERS w WHERE EXISTS (SELECT 1 FROM PAF_JDE_API.WORK_ORDER_PARTS p WHERE p.WORK_ORDER_NUMBER=w.WORK_ORDER_NUMBER AND p.WORK_ORDER_TYPE=w.WORK_ORDER_TYPE AND NVL(TRIM(p.WORK_ORDER_SUFFIX),'~')=NVL(TRIM(w.WORK_ORDER_SUFFIX),'~')) ORDER BY w.WORK_ORDER_NUMBER,w.WORK_ORDER_TYPE,w.WORK_ORDER_SUFFIX FETCH FIRST 5 ROWS ONLY",
