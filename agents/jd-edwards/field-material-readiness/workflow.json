            "database": {
              "componentProps": {
                "dependsOnValueKeys": null,
                "itemText": "label",
                "itemValue": "value",
                "label": "Select database",
                "options": null,
                "optionsEndPoint": {
                  "url": "/agentFactory/v1/agentBuilderGetRegisteredDBsOfUser"
                },
                "optionsToDisplayDependingOnValue": null
              },
              "componentType": "selectSingle",
              "display": true,
              "displayCondition": null,
              "inputTypes": null,
              "required": false,
              "value": "5D8A579B1F352BA7E0638001000A55AB",
              "valueType": "str"
            },
            "query": {
              "componentProps": {
                "dependsOnValueKeys": null,
                "disableWhenOutputConnected": null,
                "hideWhenOutputConnected": null,
                "label": "Query",
                "placeholder": "",
                "valueEndPoint": null
              },
              "componentType": "textArea",
              "display": true,
              "displayCondition": null,
              "inputTypes": [
                "message"
              ],
              "required": true,
              "value": "SELECT w.WORK_ORDER_TYPE,w.WORK_ORDER_NUMBER,w.WORK_ORDER_SUFFIX,w.WORK_ORDER_DESCRIPTION,w.BRANCH_PLANT,\n p.COMPONENT_SEQUENCE,p.OPERATION_SEQUENCE,p.COMPONENT_ITEM_NUMBER,p.COMPONENT_ITEM_CODE,p.COMPONENT_DESCRIPTION,p.COMPONENT_BRANCH,p.UOM,p.REQUIREMENT_SOURCE_ROWS,\n GREATEST(NVL(p.REQUIRED_QUANTITY,0)-NVL(p.ISSUED_QUANTITY,0)-NVL(p.CANCELLED_QUANTITY,0),0) REQUIRED_NOT_ISSUED_QTY_PER_ROW,\n i.INDICATIVE_AVAILABLE_QUANTITY,t.PRIMARY_UOM INVENTORY_UOM\n FROM (SELECT w.* FROM PAF_JDE_API.WORK_ORDERS w WHERE EXISTS\n (SELECT 1 FROM PAF_JDE_API.WORK_ORDER_PARTS p WHERE p.WORK_ORDER_NUMBER=w.WORK_ORDER_NUMBER AND p.WORK_ORDER_TYPE=w.WORK_ORDER_TYPE\n AND NVL(TRIM(p.WORK_ORDER_SUFFIX),'~')=NVL(TRIM(w.WORK_ORDER_SUFFIX),'~')) ORDER BY WORK_ORDER_NUMBER FETCH FIRST 1 ROW ONLY) w\n JOIN (SELECT WORK_ORDER_TYPE,WORK_ORDER_NUMBER,WORK_ORDER_SUFFIX,COMPONENT_SEQUENCE,OPERATION_SEQUENCE,\n COMPONENT_ITEM_NUMBER,COMPONENT_ITEM_CODE,COMPONENT_DESCRIPTION,COMPONENT_BRANCH,UOM,\n REQUIRED_QUANTITY,ISSUED_QUANTITY,CANCELLED_QUANTITY,COUNT(*) REQUIREMENT_SOURCE_ROWS\n FROM PAF_JDE_API.WORK_ORDER_PARTS GROUP BY WORK_ORDER_TYPE,WORK_ORDER_NUMBER,WORK_ORDER_SUFFIX,\n COMPONENT_SEQUENCE,OPERATION_SEQUENCE,COMPONENT_ITEM_NUMBER,COMPONENT_ITEM_CODE,COMPONENT_DESCRIPTION,\n COMPONENT_BRANCH,UOM,REQUIRED_QUANTITY,ISSUED_QUANTITY,CANCELLED_QUANTITY) p ON p.WORK_ORDER_NUMBER=w.WORK_ORDER_NUMBER AND p.WORK_ORDER_TYPE=w.WORK_ORDER_TYPE\n AND NVL(TRIM(p.WORK_ORDER_SUFFIX),'~')=NVL(TRIM(w.WORK_ORDER_SUFFIX),'~')\n LEFT JOIN PAF_JDE_API.BRANCH_INVENTORY i ON i.ITEM_NUMBER=p.COMPONENT_ITEM_NUMBER AND TRIM(i.BRANCH_PLANT)=TRIM(p.COMPONENT_BRANCH)\n LEFT JOIN PAF_JDE_API.ITEMS t ON t.ITEM_NUMBER=p.COMPONENT_ITEM_NUMBER\n ORDER BY p.COMPONENT_SEQUENCE FETCH FIRST 20 ROWS ONLY",
              "valueType": "str"
            }
          },
          "title": "SQL query",
          "type": "SelectSqlQueryNode"
        },
