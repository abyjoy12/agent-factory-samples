      "url": "https://fusion.example.invalid/fscmRestApi/resources/11.13.18.05"
    }
  ],
  "tags": [
    {
      "name": "fusion",
      "description": "Bounded Fusion business evidence"
    }
  ],
  "components": {
    "securitySchemes": {
      "FusionBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "FusionBasic": []
    }
  ],
  "paths": {
    "/suppliers": {
      "get": {
        "tags": [
          "fusion"
        ],
        "operationId": "fusion_supplier_profile_review",
        "summary": "Which supplier profile statuses should procurement verify?",
        "description": "Do not retrieve tax IDs, bank accounts, contacts or addresses. A status or business relationship does not establish risk rating, spend authorization, onboarding completion or compliance. Return only the listed fields; do not expand children. Results are a sample, not a complete population.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "description": "Read a maximum of ten rows.",
            "schema": {
              "type": "integer",
              "enum": [
                10
              ],
              "default": 10
            }
          },
          {
            "name": "onlyData",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean",
              "enum": [
                true
              ],
              "default": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": true,
            "description": "Use this exact projection: SupplierId,SupplierNumber,Supplier,Status,BusinessRelationship",
            "schema": {
              "type": "string",
              "enum": [
                "SupplierId,SupplierNumber,Supplier,Status,BusinessRelationship"
              ],
              "default": "SupplierId,SupplierNumber,Supplier,Status,BusinessRelationship"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded Fusion collection; inspect count and hasMore. Empty data is not an access or completeness guarantee.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "hasMore": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
