  "paths": {
    "/fscmRestApi/resources/11.13.18.05/salesOrdersForOrderHub": {
      "get": {
        "tags": [
          "fusion"
        ],
        "operationId": "fusion_order_fulfillment_review",
        "summary": "Which sales-order headers need an order-manager follow-up?",
        "description": "A header status is not proof of line shipment, promised delivery or revenue recognition. Explain missing line and fulfillment evidence. Never release holds, submit or reschedule orders. Return only the listed fields; do not expand children. Results are a sample, not a complete population.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "description": "Read a maximum of ten rows.",
            "schema": {
              "type": "integer",
              "enum": [
                10
              ],
              "default": 10
            }
          },
          {
            "name": "onlyData",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean",
              "enum": [
                true
              ],
              "default": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": true,
            "description": "Use this exact projection: HeaderId,OrderNumber,StatusCode,TransactionOn,TransactionalCurrencyCode",
            "schema": {
              "type": "string",
              "enum": [
                "HeaderId,OrderNumber,StatusCode,TransactionOn,TransactionalCurrencyCode"
              ],
              "default": "HeaderId,OrderNumber,StatusCode,TransactionOn,TransactionalCurrencyCode"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded Fusion collection; inspect count and hasMore. Empty data is not an access or completeness guarantee.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "hasMore": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
