              "inputTypes": [
                "message"
              ],
              "required": true,
              "value": "SELECT p.POSITION_NBR,p.POSITION_TITLE,p.BUSINESS_UNIT,p.DEPTID,p.EFF_STATUS,p.MAX_HEAD_COUNT,p.FTE POSITION_FTE,\n NVL(a.ASSIGNMENT_COUNT,0) ASSIGNMENT_COUNT,NVL(a.EMPLOYEE_COUNT,0) DISTINCT_EMPLOYEES_AT_POSITION,\n NVL(a.ASSIGNMENT_FTE,0) ASSIGNMENT_FTE,p.EFFDT POSITION_EFFECTIVE_DATE,\n a.FIRST_ASSIGNMENT_EFFECTIVE_DATE,a.LAST_ASSIGNMENT_EFFECTIVE_DATE\nFROM PAF_DATA.HCM_POSITIONS p LEFT JOIN\n (SELECT POSITION_NBR,COUNT(*) ASSIGNMENT_COUNT,COUNT(DISTINCT EMPLOYEE_ID) EMPLOYEE_COUNT,\n SUM(FTE) ASSIGNMENT_FTE,MIN(EFFDT) FIRST_ASSIGNMENT_EFFECTIVE_DATE,MAX(EFFDT) LAST_ASSIGNMENT_EFFECTIVE_DATE\n FROM PAF_DATA.HCM_ASSIGNMENTS WHERE POSITION_NBR IS NOT NULL GROUP BY POSITION_NBR) a\n ON a.POSITION_NBR=p.POSITION_NBR\nORDER BY NVL(a.ASSIGNMENT_COUNT,0),p.POSITION_NBR FETCH FIRST 10 ROWS ONLY",
              "valueType": "str"
            }
          },
