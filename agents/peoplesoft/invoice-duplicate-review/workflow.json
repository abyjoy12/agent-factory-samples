              "value": "SELECT BUSINESS_UNIT, VENDOR_SETID, VENDOR_ID, UPPER(TRIM(INVOICE_ID)) NORMALIZED_INVOICE_ID,\n TXN_CURRENCY_CD, GROSS_AMT, COUNT(*) CANDIDATE_COUNT, MIN(INVOICE_DT) FIRST_INVOICE_DATE,\n MAX(INVOICE_DT) LAST_INVOICE_DATE, MIN(VOUCHER_ID) EXAMPLE_VOUCHER\nFROM PAF_DATA.FSCM_INVOICES\nWHERE INVOICE_ID IS NOT NULL\nGROUP BY BUSINESS_UNIT,VENDOR_SETID,VENDOR_ID,UPPER(TRIM(INVOICE_ID)),TXN_CURRENCY_CD,GROSS_AMT\nHAVING COUNT(*) > 1\nORDER BY CANDIDATE_COUNT DESC,BUSINESS_UNIT,VENDOR_ID,NORMALIZED_INVOICE_ID FETCH FIRST 5 ROWS ONLY",
