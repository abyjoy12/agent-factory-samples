{
  "openapi": "3.0.3",
  "info": {
    "title": "Payables Invoice Review — Fusion ERP",
    "version": "1.0.0",
    "description": "Which supplier invoices need an AP review before payment?"
  },
  "servers": [
    {
      "url": "https://fusion.example.invalid"
    }
  ],
  "tags": [
    {
      "name": "fusion",
      "description": "Bounded Fusion business evidence"
    }
  ],
  "components": {
    "securitySchemes": {
      "FusionBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "FusionBasic": []
    }
  ],
  "paths": {
    "/fscmRestApi/resources/11.13.18.05/invoices": {
      "get": {
        "tags": [
          "fusion"
        ],
        "operationId": "fusion_payables_invoice_review",
        "summary": "Which supplier invoices need an AP review before payment?",
        "description": "Separate validation, approval and paid statuses. Preserve business unit and currency. InvoiceAmount is not an unpaid balance; do not calculate outstanding amounts without installments and applications. Never approve, pay, hold or cancel invoices. Return only the listed fields; do not expand children. Results are a sample, not a complete population.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "description": "Read a maximum of ten rows.",
            "schema": {
              "type": "integer",
              "enum": [
                10
              ],
              "default": 10
            }
          },
          {
            "name": "onlyData",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean",
              "enum": [
                true
              ],
              "default": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": true,
            "description": "Use this exact projection: InvoiceId,InvoiceNumber,InvoiceDate,InvoiceAmount,InvoiceCurrency,BusinessUnit,ValidationStatus,ApprovalStatus,PaidStatus",
            "schema": {
              "type": "string",
              "enum": [
                "InvoiceId,InvoiceNumber,InvoiceDate,InvoiceAmount,InvoiceCurrency,BusinessUnit,ValidationStatus,ApprovalStatus,PaidStatus"
              ],
              "default": "InvoiceId,InvoiceNumber,InvoiceDate,InvoiceAmount,InvoiceCurrency,BusinessUnit,ValidationStatus,ApprovalStatus,PaidStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded Fusion collection; inspect count and hasMore. Empty data is not an access or completeness guarantee.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "hasMore": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
