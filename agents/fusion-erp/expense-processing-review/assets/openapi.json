{
  "openapi": "3.0.3",
  "info": {
    "title": "Expense Processing Review — Fusion ERP",
    "version": "1.0.0",
    "description": "Which expense reports need a processing-status follow-up?"
  },
  "servers": [
    {
      "url": "https://fusion.example.invalid"
    }
  ],
  "tags": [
    {
      "name": "fusion",
      "description": "Bounded Fusion business evidence"
    }
  ],
  "components": {
    "securitySchemes": {
      "FusionBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "FusionBasic": []
    }
  ],
  "paths": {
    "/fscmRestApi/resources/11.13.18.05/expenseReports": {
      "get": {
        "tags": [
          "fusion"
        ],
        "operationId": "fusion_expense_processing_review",
        "summary": "Which expense reports need a processing-status follow-up?",
        "description": "Omit employee names, personal expenses and attachments. Preserve returned status codes; do not label reports fraudulent, approve reimbursements or make employee judgments. Return only the listed fields; do not expand children. Results are a sample, not a complete population.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "description": "Read a maximum of ten rows.",
            "schema": {
              "type": "integer",
              "enum": [
                10
              ],
              "default": 10
            }
          },
          {
            "name": "onlyData",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean",
              "enum": [
                true
              ],
              "default": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": true,
            "description": "Use this exact projection: ExpenseReportId,ExpenseReportNumber,ExpenseReportDate,ExpenseReportTotal,ReimbursementCurrencyCode,ExpenseStatusCode",
            "schema": {
              "type": "string",
              "enum": [
                "ExpenseReportId,ExpenseReportNumber,ExpenseReportDate,ExpenseReportTotal,ReimbursementCurrencyCode,ExpenseStatusCode"
              ],
              "default": "ExpenseReportId,ExpenseReportNumber,ExpenseReportDate,ExpenseReportTotal,ReimbursementCurrencyCode,ExpenseStatusCode"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded Fusion collection; inspect count and hasMore. Empty data is not an access or completeness guarantee.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "hasMore": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
