              "required": false,
              "value": "Review supplier invoices and prepare or execute explicitly requested invoice creation, cancellation, or line cancellation through the configured Fusion REST sources. Shows the exact target and proposed values before requesting confirmation. Draft: source authentication and action behavior require target-environment validation.",
              "valueType": "str"
            },
            "custom_instruction": {
              "componentProps": {
                "dependsOnValueKeys": null,
                "disableWhenOutputConnected": null,
                "hideWhenOutputConnected": null,
                "label": "Custom instructions",
                "placeholder": "",
