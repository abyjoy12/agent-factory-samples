{
  "openapi": "3.0.3",
  "info": {
    "title": "Position Structure Review — Fusion HCM",
    "version": "1.0.0",
    "description": "Which position records need a workforce-planning check?"
  },
  "servers": [
    {
      "url": "https://fusion.example.invalid"
    }
  ],
  "tags": [
    {
      "name": "fusion",
      "description": "Bounded Fusion business evidence"
    }
  ],
  "components": {
    "securitySchemes": {
      "FusionBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "FusionBasic": []
    }
  ],
  "paths": {
    "/hcmRestApi/resources/11.13.18.05/positions": {
      "get": {
        "tags": [
          "fusion"
        ],
        "operationId": "fusion_position_structure_review",
        "summary": "Which position records need a workforce-planning check?",
        "description": "Position headcount or FTE is configured capacity, not filled positions or actual employee counts. Respect effective dates. Do not rank people, recommend individual employment decisions or infer vacancies without assignment evidence. Return only the listed fields; do not expand children. Results are a sample, not a complete population.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "description": "Read a maximum of ten rows.",
            "schema": {
              "type": "integer",
              "enum": [
                10
              ],
              "default": 10
            }
          },
          {
            "name": "onlyData",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean",
              "enum": [
                true
              ],
              "default": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": true,
            "description": "Use this exact projection: PositionId,PositionCode,Name,ActiveStatus,EffectiveStartDate,EffectiveEndDate,HeadCount,FTE",
            "schema": {
              "type": "string",
              "enum": [
                "PositionId,PositionCode,Name,ActiveStatus,EffectiveStartDate,EffectiveEndDate,HeadCount,FTE"
              ],
              "default": "PositionId,PositionCode,Name,ActiveStatus,EffectiveStartDate,EffectiveEndDate,HeadCount,FTE"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded Fusion collection; inspect count and hasMore. Empty data is not an access or completeness guarantee.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "hasMore": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
