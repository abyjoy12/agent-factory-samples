{
  "openapi": "3.0.3",
  "info": {
    "title": "Work Location Review — Fusion HCM",
    "version": "1.0.0",
    "description": "Which work locations need a setup or effective-date check?"
  },
  "servers": [
    {
      "url": "https://fusion.example.invalid"
    }
  ],
  "tags": [
    {
      "name": "fusion",
      "description": "Bounded Fusion business evidence"
    }
  ],
  "components": {
    "securitySchemes": {
      "FusionBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "FusionBasic": []
    }
  ],
  "paths": {
    "/hcmRestApi/resources/11.13.18.05/locations": {
      "get": {
        "tags": [
          "fusion"
        ],
        "operationId": "fusion_location_readiness_review",
        "summary": "Which work locations need a setup or effective-date check?",
        "description": "Location activation is configuration evidence, not confirmation of physical accessibility, office capacity or employee presence. Do not retrieve personal addresses. Return only the listed fields; do not expand children. Results are a sample, not a complete population.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "description": "Read a maximum of ten rows.",
            "schema": {
              "type": "integer",
              "enum": [
                10
              ],
              "default": 10
            }
          },
          {
            "name": "onlyData",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean",
              "enum": [
                true
              ],
              "default": true
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": true,
            "description": "Use this exact projection: LocationId,LocationCode,LocationName,ActiveStatus,EffectiveStartDate,EffectiveEndDate",
            "schema": {
              "type": "string",
              "enum": [
                "LocationId,LocationCode,LocationName,ActiveStatus,EffectiveStartDate,EffectiveEndDate"
              ],
              "default": "LocationId,LocationCode,LocationName,ActiveStatus,EffectiveStartDate,EffectiveEndDate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded Fusion collection; inspect count and hasMore. Empty data is not an access or completeness guarantee.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "hasMore": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
